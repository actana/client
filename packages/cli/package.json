{
  "name": "@actana/cli",
  "version": "0.5.0",
  "description": "Actana CLI — the `actana` command for driving Cores and product nouns built on @actana/sdk.",
  "license": "MIT",
  "type": "module",
  "keywords": ["actana", "cli", "core-link"],
  "homepage": "https://github.com/actana/client/tree/main/packages/cli#readme",
  "bugs": "https://github.com/actana/client/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/client.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": ["dist", "bin", "data"],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "actana": "bin/actana.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actana/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
