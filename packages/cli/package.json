{
  "name": "@actana/cli",
  "version": "0.6.0-next.2",
  "description": "Actana CLI — the `actana` command for driving Cores and product nouns built on @actana/sdk.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "actana",
    "cli",
    "core-link"
  ],
  "homepage": "https://github.com/actana/client/tree/main/packages/cli#readme",
  "bugs": "https://github.com/actana/client/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/client.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": [
    "dist",
    "bin",
    "data"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "actana": "bin/actana.mjs"
  },
  "scripts": {
    "build": "pnpm --filter @actana/sdk run build && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter @actana/sdk run build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actana/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
