{
  "name": "@actana/sdk",
  "version": "0.5.0",
  "description": "Actana SDK — core-link client, pairing, and product entry points.",
  "license": "MIT",
  "type": "module",
  "keywords": ["actana", "core-link", "sdk", "pairing"],
  "homepage": "https://github.com/actana/client/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/actana/client/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/client.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": ["dist"],
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "undici": "8.9.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
