{
  "name": "@actana/sdk",
  "version": "0.5.0",
  "description": "Actana SDK — core-link client, pairing, and product entry points.",
  "license": "MIT",
  "type": "module",
  "keywords": ["actana", "core-link", "sdk", "pairing"],
  "homepage": "https://github.com/actana/client/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/actana/client/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/client.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    "./pairing": "./src/pairing.ts",
    "./pairing/server": "./src/pairing/server/index.ts",
    "./pairing/stores/json-file": "./src/pairing/stores/json-file.ts",
    "./pairing/stores/postgres": "./src/pairing/stores/postgres.ts",
    "./core": "./src/core.ts",
    "./core/link-frames": "./src/core/browser.ts",
    "./search": "./src/search.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./pairing": {
        "types": "./dist/pairing.d.ts",
        "default": "./dist/pairing.js"
      },
      "./pairing/server": {
        "types": "./dist/pairing/server/index.d.ts",
        "default": "./dist/pairing/server/index.js"
      },
      "./pairing/stores/json-file": {
        "types": "./dist/pairing/stores/json-file.d.ts",
        "default": "./dist/pairing/stores/json-file.js"
      },
      "./pairing/stores/postgres": {
        "types": "./dist/pairing/stores/postgres.d.ts",
        "default": "./dist/pairing/stores/postgres.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./core/link-frames": {
        "types": "./dist/core/browser.d.ts",
        "default": "./dist/core/browser.js"
      },
      "./search": {
        "types": "./dist/search.d.ts",
        "default": "./dist/search.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/vendor-control-pin.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@peculiar/x509": "1.14.2",
    "selfsigned": "5.5.0",
    "undici": "8.9.0",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "pg": "8.16.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
